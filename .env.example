# Copy to .env and fill in real values. .env is git-ignored.

# --- LLM providers (set the ones you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEFAULT_PROVIDER=anthropic

# --- Storage ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/multi_agent
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Feature flags (Phase 7) — toggle subsystems; handy for ablation ---
ENABLE_MEMORY=true
ENABLE_EVALUATION=true
ENABLE_LEARNING=true
ENABLE_DREAMING=true

# --- Tuning ---
MAX_DELEGATION_DEPTH=2
DREAM_MIN_MEMORIES=8
DREAM_INTERVAL_HOURS=24
