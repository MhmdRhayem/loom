# Copy to .env and fill in real values. .env is git-ignored.

# --- LLM providers (set the ones you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEFAULT_PROVIDER=anthropic

# --- Storage ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/multi_agent
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Frontend / CORS ---
# Comma-separated browser origins allowed to call the API. Defaults to the Vite dev
# server. Use "*" to allow any origin (dev only; disables credentialed requests).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth (demo login) ---
# Secret that signs the demo's JWTs. Leaving this blank falls back to a public dev-only
# default and logs a warning at startup; set a real value (32+ bytes) for anything shared.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=change-me-to-a-random-32-byte-string

# --- Feature flags — toggle subsystems; handy for ablation ---
ENABLE_MEMORY=true
ENABLE_EVALUATION=true
ENABLE_LEARNING=true
ENABLE_DREAMING=true

# --- Tuning ---
MAX_DELEGATION_DEPTH=2
DREAM_MIN_MEMORIES=8
DREAM_INTERVAL_HOURS=24
